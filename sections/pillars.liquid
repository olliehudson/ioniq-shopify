<section class="pillars">
  <div class="wrap-wide">
    <div class="pillars-head">
      <span class="eyebrow">Inside the stick</span>
      <h2>Clinical doses. <em>Nothing hidden.</em></h2>
      <p>Built on an electrolyte foundation — 750mg sodium, 200mg potassium, 50mg magnesium — with four performance actives layered on top. Here's exactly what's in it, and how much.</p>
    </div>
    <div class="pillars-grid">
      <div class="pillar-card">
        <div class="pillar-num">01 / Energy</div>
        <span class="pillar-ico"><svg viewBox="0 0 24 24"><use href="#i-bolt"/></svg></span>
        <h4>Energy<br>(pre-workout)</h4>
        <p class="pillar-role">Stim-free pre-workout: blood flow, fatigue resistance.</p>
        <ul class="pillar-ings">
          <li><span class="ing">Rhodiola rosea (3%)</span><span class="dose">200mg</span></li>
          <li><span class="ing">Sodium</span><span class="dose">750mg</span></li>
        </ul>
      </div>
      <div class="pillar-card">
        <div class="pillar-num">02 / Endurance</div>
        <span class="pillar-ico"><svg viewBox="0 0 24 24"><use href="#i-leaf"/></svg></span>
        <h4>Endurance</h4>
        <p class="pillar-role">Blood flow and fatigue resistance late in a session.</p>
        <ul class="pillar-ings">
          <li><span class="ing">L-Citrulline</span><span class="dose">3g</span></li>
          <li><span class="ing">Potassium</span><span class="dose">200mg</span></li>
        </ul>
      </div>
      <div class="pillar-card">
        <div class="pillar-num">03 / Focus</div>
        <span class="pillar-ico"><svg viewBox="0 0 24 24"><use href="#i-brain"/></svg></span>
        <h4>Focus<br>(mental edge)</h4>
        <p class="pillar-role">Attention and mental edge — a single focus actor.</p>
        <ul class="pillar-ings">
          <li><span class="ing">Citicoline</span><span class="dose">250mg</span></li>
          <li><span class="ing">Magnesium</span><span class="dose">50mg</span></li>
        </ul>
      </div>
      <div class="pillar-card">
        <div class="pillar-num">04 / Recovery</div>
        <span class="pillar-ico"><svg viewBox="0 0 24 24"><use href="#i-shield"/></svg></span>
        <h4>Recovery</h4>
        <p class="pillar-role">Muscle recovery, strength and repeated-effort output.</p>
        <ul class="pillar-ings">
          <li><span class="ing">Creatine monohydrate</span><span class="dose">3g</span></li>
        </ul>
      </div>
    </div>
  </div>
</section>
{% schema %}
{ "name": "Four-pillar ingredients", "presets": [{ "name": "Four-pillar ingredients" }] }
{% endschema %}
