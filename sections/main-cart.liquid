<section class="cartpage" style="padding: clamp(48px, 7vw, 90px) 0; background: var(--paper);">
  <div class="wrap-narrow" style="max-width: 820px;">
    <h1 style="font-family: var(--font-display); font-weight: 900; font-size: clamp(34px, 5vw, 52px); text-transform: uppercase; letter-spacing: -.02em; margin: 0 0 32px;">Your cart</h1>
    {% if cart.item_count == 0 %}
      <p style="font-size:16px;">Your cart is empty. <a href="{{ routes.all_products_collection_url }}" style="color: var(--green-deep); text-decoration: underline;">Shop now →</a></p>
    {% else %}
      {% form 'cart', cart %}
        <div class="cartpage__items">
          {% for item in cart.items %}
            <div class="cartpage__line">
              <a href="{{ item.url }}" class="cartpage__img">
                {% if item.image %}<img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.product.title | escape }}">{% endif %}
              </a>
              <div class="cartpage__info">
                <div class="cartpage__title">{{ item.product.title }}</div>
                {% if item.variant.title != 'Default Title' %}<div class="cartpage__variant">{{ item.variant.title }}</div>{% endif %}
                {% if item.selling_plan_allocation %}<div class="cartpage__plan">{{ item.selling_plan_allocation.selling_plan.name }}</div>{% endif %}
                <div class="cartpage__controls">
                  <div class="cartpage__qty">
                    <a href="{{ routes.cart_change_url }}?id={{ item.key }}&quantity={{ item.quantity | minus: 1 }}" aria-label="Decrease">−</a>
                    <span>{{ item.quantity }}</span>
                    <a href="{{ routes.cart_change_url }}?id={{ item.key }}&quantity={{ item.quantity | plus: 1 }}" aria-label="Increase">+</a>
                  </div>
                  <a href="{{ routes.cart_change_url }}?id={{ item.key }}&quantity=0" class="cartpage__remove" aria-label="Remove">Remove</a>
                </div>
              </div>
              <div class="cartpage__price">{{ item.final_line_price | money }}</div>
            </div>
          {% endfor %}
        </div>
        <div class="cartpage__foot">
          <div class="cartpage__sub"><span>Subtotal</span><strong>{{ cart.total_price | money }}</strong></div>
          <p class="cartpage__note">Shipping &amp; taxes calculated at checkout.</p>
          <button type="submit" name="checkout" class="btn btn-primary btn-lg btn-block">Checkout · {{ cart.total_price | money }}</button>
        </div>
      {% endform %}
    {% endif %}
  </div>
</section>

<style>
  .cartpage__items{ border-top: 1px solid var(--line); }
  .cartpage__line{ display: grid; grid-template-columns: 92px 1fr auto; gap: 20px; align-items: center; padding: 22px 0; border-bottom: 1px solid var(--line); }
  .cartpage__img{ width: 92px; height: 92px; border-radius: 12px; overflow: hidden; background: var(--paper-2); display: block; }
  .cartpage__img img{ width: 100%; height: 100%; object-fit: cover; display: block; }
  .cartpage__title{ font-family: var(--font-display); font-weight: 800; font-size: 16px; text-transform: uppercase; letter-spacing: .01em; }
  .cartpage__variant, .cartpage__plan{ font-size: 13px; color: var(--ink-soft); margin-top: 3px; }
  .cartpage__plan{ color: var(--green-deep); }
  .cartpage__controls{ display: flex; align-items: center; gap: 16px; margin-top: 12px; }
  .cartpage__qty{ display: inline-flex; align-items: center; border: 1px solid var(--line-strong); border-radius: 8px; overflow: hidden; }
  .cartpage__qty a{ width: 34px; height: 36px; display: grid; place-items: center; background: var(--white); color: var(--ink); font-family: var(--font-display); font-weight: 800; font-size: 17px; text-decoration: none; }
  .cartpage__qty a:hover{ background: var(--paper-2); }
  .cartpage__qty span{ width: 38px; text-align: center; font-family: var(--font-display); font-weight: 800; font-size: 14px; }
  .cartpage__remove{ font-family: var(--font-mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-soft); text-decoration: underline; text-underline-offset: 3px; }
  .cartpage__remove:hover{ color: var(--green-deep); }
  .cartpage__price{ font-family: var(--font-display); font-weight: 800; font-size: 17px; white-space: nowrap; }
  .cartpage__foot{ margin-top: 28px; }
  .cartpage__sub{ display: flex; align-items: center; justify-content: space-between; font-family: var(--font-display); margin-bottom: 4px; }
  .cartpage__sub span{ font-weight: 700; text-transform: uppercase; letter-spacing: .04em; font-size: 15px; }
  .cartpage__sub strong{ font-weight: 900; font-size: 26px; }
  .cartpage__note{ font-size: 13px; color: var(--ink-soft); margin: 0 0 18px; }
  @media (max-width: 560px){ .cartpage__line{ grid-template-columns: 72px 1fr; } .cartpage__price{ grid-column: 2; text-align: right; } .cartpage__img{ width: 72px; height: 72px; } }
</style>
{% schema %}
{ "name": "Cart", "enabled_on": { "templates": ["cart"] } }
{% endschema %}
