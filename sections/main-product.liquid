{% if product == blank or product == empty %}<section class="pdp"><div class="wrap-wide" style="padding:80px 0;text-align:center;"><h2 style="font-family:var(--font-display);font-weight:900;font-size:48px;text-transform:uppercase;margin-bottom:16px;">Product not loaded</h2><a href="/products/ioniq-morning-ritual" class="btn btn-primary btn-lg">View IONIQ product →</a></div></section>{% else %}<section class="pdp">
  <div class="wrap-wide">
    <div class="pdp-grid">

      <!-- GALLERY -->
      <div class="gallery">
        <div class="gallery-main">
          {% if product.featured_image %}
            <img id="hero-img-{{ section.id }}" src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.featured_image.alt | escape }}">
          {% else %}
            <img id="hero-img-{{ section.id }}" src="{{ 'product-hero.webp' | asset_url }}" alt="IONIQ">
          {% endif %}
        </div>
        {% if product.images.size > 1 %}
          <div class="gallery-thumbs">
            {% for img in product.images limit: 4 %}
              <button class="thumb{% if forloop.first %} is-active{% endif %}" data-img="{{ img | image_url: width: 1200 }}">
                <img src="{{ img | image_url: width: 200 }}" alt="">
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <!-- BUY -->
      <div class="buy">
        {% if product.metafields.reviews.rating %}
        <div class="buy-rating">
          <span class="stars">{% for i in (1..5) %}<svg width="14" height="14"><use href="#i-star"/></svg>{% endfor %}</span>
          <strong>{{ product.metafields.reviews.rating }}</strong>
          <span>· {{ product.metafields.reviews.rating_count }} reviews</span>
        </div>
        {% endif %}

        <div>
          <div class="buy-title-row">
            <h1>{{ product.title }}</h1>
            <span class="buy-tag"><span class="dot"></span>New</span>
          </div>
          <p class="buy-summary" style="margin-top:14px;">For people who actually train — tennis, padel, football, running, lifting. One stick brings together a stim-free pre-workout, your electrolytes, focus and recovery — with <strong>3g creatine</strong> and <strong>3g citrulline</strong> at doses that do something. No caffeine. No sugar. No flavoured water.</p>
        </div>

        <div class="buy-meta">
          <span><strong>750mg</strong> sodium</span><span class="sep"></span>
          <span><strong>3g</strong> creatine</span><span class="sep"></span>
          <span><strong>3g</strong> citrulline</span><span class="sep"></span>
          <span><strong>7</strong> actives</span><span class="sep"></span>
          <span>30 sticks</span>
        </div>

        {% form 'product', product, id: 'product-form-{{ section.id }}' %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          {% if product.variants.size > 1 %}
            <div>
              <div class="section-label">{{ product.options.first }}</div>
              <div class="flavors">
                {% for variant in product.variants %}
                  <button type="button" class="flavor{% if variant == product.selected_or_first_available_variant %} is-selected{% endif %}{% unless variant.available %} is-soon{% endunless %}" data-variant-id="{{ variant.id }}">
                    {% unless variant.available %}<span class="ribbon">Soon</span>{% endunless %}
                    <span class="swatch" style="background: linear-gradient(160deg, #F4ECDB, #B0B8A4);"></span>
                    <span class="nm">{{ variant.title }}</span>
                  </button>
                {% endfor %}
              </div>
            </div>
          {% endif %}

          {%- comment -%} Kaching Bundles renders its quantity-breaks / subscribe widget here. Enable the app embed in Theme editor, then set its custom placement target to .kaching-bundles {%- endcomment -%}
          <div class="kaching-bundles" data-kaching-bundles></div>

          <div class="atc-row">
            <div class="qty">
              <button type="button" data-qty="-1">-</button>
              <input type="number" name="quantity" value="1" min="1" style="width:32px;text-align:center;border:none;background:transparent;font-family:var(--font-display);font-weight:800;font-size:15px;">
              <button type="button" data-qty="+1">+</button>
            </div>
            <button type="submit" class="atc-btn">
              <span>Add to cart</span>
              <span>{{ product.price | money_without_trailing_zeros }}</span>
            </button>
          </div>
        {% endform %}

        <div class="atc-meta">Tax included. <a href="#">Shipping calculated at checkout.</a> 60-day risk-free guarantee — refund any unused box.</div>

        <details class="acc" open>
          <summary>Key benefits</summary>
          <div class="body">
            <ul style="margin:0; padding-left:18px; list-style:disc;">
              <li><strong>Stim-free pre-workout</strong> — 3g L-citrulline for blood flow and endurance, rhodiola for clean energy. No caffeine, no crash.</li>
              <li><strong>Real electrolytes</strong> — 750mg sodium, plus potassium and magnesium, dosed to what you actually sweat out.</li>
              <li><strong>Focus, one clean actor</strong> — 250mg citicoline for attention. No stimulant.</li>
              <li><strong>Recovery that's actually dosed</strong> — 3g creatine monohydrate for strength and repeated-effort recovery.</li>
              <li><strong>Nothing hidden</strong> — every milligram on the label. No caffeine, no sugar, no proprietary blends.</li>
            </ul>
          </div>
        </details>
        <details class="acc">
          <summary>How to use</summary>
          <div class="body">
            <p>Tear one stick into 500–600ml of cold water, stir well and drink — a little sediment from the creatine is normal. Have one 30–45 minutes before training and/or one after. Creatine works on daily consistency, so a stick a day (even on rest days) is ideal.</p>
          </div>
        </details>
        <details class="acc">
          <summary>Full ingredient list</summary>
          <div class="body">
            <p>Himalayan pink salt (sodium), potassium citrate, magnesium citrate, L-citrulline, creatine monohydrate, Rhodiola rosea extract (3% rosavins), citicoline, citric acid, natural lemon flavour, monk fruit extract, organic stevia leaf extract, silicon dioxide. No fillers, no proprietary blends, no artificial colours or flavours.</p>
          </div>
        </details>
        <details class="acc">
          <summary>Nutritional info</summary>
          <div class="body">
            <p>Per stick (~9.75g): Energy ~15 kcal · Sodium 750mg · Potassium 200mg · Magnesium 50mg · L-Citrulline 3,000mg · Creatine monohydrate 3,000mg · Rhodiola 200mg · Citicoline 250mg · Total sugars 0g · Caffeine 0mg.</p>
          </div>
        </details>
        <details class="acc">
          <summary>Shipping &amp; returns</summary>
          <div class="body">
            <p>Free shipping on all subscriptions. Orders typically deliver in 2-4 business days. 60-day risk-free guarantee on every order — if it doesn't work for you, send the box back for a full refund. No restocking fees, ever.</p>
          </div>
        </details>
      </div>
    </div>
  </div>
</section>
<script>
  document.querySelectorAll('.thumb').forEach(t => {
    t.addEventListener('click', () => {
      document.querySelectorAll('.thumb').forEach(x => x.classList.remove('is-active'));
      t.classList.add('is-active');
      const heroImg = document.querySelector('[id^="hero-img-"]');
      if (heroImg) heroImg.src = t.dataset.img;
    });
  });
  document.querySelectorAll('.flavor:not(.is-soon)').forEach(f => {
    f.addEventListener('click', () => {
      document.querySelectorAll('.flavor').forEach(x => x.classList.remove('is-selected'));
      f.classList.add('is-selected');
      const idField = document.querySelector('[name="id"]');
      if (idField) idField.value = f.dataset.variantId;
    });
  });
  document.querySelectorAll('.qty button').forEach(b => {
    b.addEventListener('click', () => {
      const input = b.parentNode.querySelector('input');
      input.value = Math.max(1, parseInt(input.value) + parseInt(b.dataset.qty));
    });
  });
</script>
{% endif %}
{% schema %}
{ "name": "Main product", "enabled_on": { "templates": ["product"] } }
{% endschema %}